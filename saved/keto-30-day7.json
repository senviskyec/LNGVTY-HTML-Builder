      "key": "chCall",
      "theme": "white",
      "html": "<div style=\"background:var(--secbg);padding:44px 48px 20px;\">\n      <div contenteditable=\"true\" data-ph=\"This is happening today\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:#bbbbbb;margin-bottom:6px;\" class=\"\">this is happening tomorrow</div>\n      <div contenteditable=\"true\" data-ph=\"Weekly Check-In Call\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--sectext);text-transform:uppercase;line-height:1.1;margin-bottom:20px;\" class=\"\">weekly check-in chall #1</div>\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;border:1px solid #f0f0f0;margin-bottom:20px;\"><tbody><tr>\n        <td width=\"80\" valign=\"middle\" align=\"center\" style=\"width:80px;background:var(--gray);padding:16px 8px;text-align:center;\">\n          <div contenteditable=\"true\" data-ph=\"Week 1\" style=\"font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#ffffff;opacity:.7;\" class=\"\">week 1</div>\n          <div contenteditable=\"true\" data-ph=\"07\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:30px;color:#ffffff;line-height:1.1;\" class=\"\">07</div>\n          <div contenteditable=\"true\" data-ph=\"Sunday\" style=\"font-size:9px;color:#ffffff;opacity:.6;font-weight:300;text-transform:capitalize;margin-top:2px;\" class=\"\">Sunday</div>\n        </td>\n        <td valign=\"top\" style=\"padding:16px 18px;\">\n          <div style=\"margin-bottom:6px;\"><span contenteditable=\"true\" data-ph=\"Sunday at [TIME]\" style=\"font-family:'Montserrat',sans-serif;font-weight:700;font-size:15px;color:var(--heading);text-transform:uppercase;display:inline;\" class=\"\">sunday</span> <span contenteditable=\"true\" data-ph=\"· LNGVTY Hub\" style=\"font-size:12px;color:#999999;font-weig