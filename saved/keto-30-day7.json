-serif;font-weight:900;font-size:12px;color:#ffffff;\" class=\"\">2</div></td></tr></tbody></table></td>\n        <td valign=\"top\" style=\"padding:0 0 18px 4px;\"><div contenteditable=\"true\" data-ph=\"Second step.\" style=\"font-size:14px;line-height:1.65;color:var(--secmuted);font-weight:300;\" class=\"\">Give things multiple tries - I've hear it takes <b>7+ exposures</b>&nbsp;before you build a genuine taste for something new.</div></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td width=\"34\" valign=\"top\" style=\"width:34px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:26px;height:26px;background:var(--accent);border-radius:50%;\"><tbody><tr><td align=\"center\" valign=\"middle\" style=\"width:26px;height:26px;line-height:26px;\"><div contenteditable=\"true\" data-ph=\"3\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:12px;color:#ffffff;\" class=\"\">3</div></td></tr></tbody></table></td>\n        <td valign=\"top\" style=\"padding:0 0 18px 4px;\"><div contenteditable=\"true\" data-ph=\"Third step.\" style=\"font-size:14px;line-height:1.65;color:var(--secmuted);font-weight:300;\" class=\"\">It takes time - but on the other side, <b>sugar stops tasting like anything special.</b></div></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ Add step</button>\n      </div>\n    \n    \n    "
