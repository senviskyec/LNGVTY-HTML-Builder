      "theme": "dark",
      "html": "<div style=\"background:var(--secbg);padding:40px 48px;\">\n      <div contenteditable=\"true\" data-ph=\"Watch this week’s video\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--accent);margin-bottom:6px;\" class=\"\">watch this week's video</div>\n      <div contenteditable=\"true\" data-ph=\"Video Title Goes Here\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--sectext);text-transform:uppercase;line-height:1.1;margin-bottom:20px;\" class=\"\">week 1: taste buds &amp; the rest</div>\n      <span class=\"editable-link\" data-href=\"#\" style=\"display:block;position:relative;\">\n        <a contenteditable=\"false\" href=\"#\" style=\"display:block;text-decoration:none;\">\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;background:#3a3a3a;border:1px solid #4a4a4a;\">\n            <tbody><tr><td align=\"center\" valign=\"middle\" style=\"padding:60px 20px;\">\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:66px;height:66px;background:var(--accent);border-radius:50%;margin:0 auto;\"><tbody><tr><td align=\"center\" valign=\"middle\" style=\"width:66px;height:66px;line-height:66px;font-size:24px;color:#ffffff;\">▶</td></tr></tbody></table>\n              <div style=\"margin-top:16px;\"><div contenteditable=\"true\" data-ph=\"Tap to play  ·  4 min\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#cccccc;\" class=\"is-empty\"></div></div>\n            </td></tr>\n          </tbody></table>\n        </a>\n        <button class=\"link-edit\" type=\"button\" onclick=\"openLinkModal(this)\">🔗 link</button>\n      </span>\n      <div style=\"margin-top:10px;font-size:11px;line-height:1.5;color:var(--secmuted);font-weight: