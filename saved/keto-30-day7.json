      "key": "scanurgency",
      "theme": "white",
      "html": "<div style=\"background:var(--secbg);padding:36px 48px;border-bottom:1px solid #eee;\">\n        <div contenteditable=\"true\" data-ph=\"⚠ Action Required\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;letter-spacing:4px;text-transform:uppercase;color:#bbb;margin-bottom:6px;\" class=\"\">action required</div>\n        <div contenteditable=\"true\" data-ph=\"Book Your Final Scan.\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--heading);text-transform:uppercase;margin-bottom:20px;line-height:1.1;\" class=\"\">book your first scan</div>\n        <div style=\"background:var(--dark);border-top:3px solid var(--accent);padding:28px;\">\n          <div contenteditable=\"true\" data-ph=\"⏱ 7-Day Window\" style=\"display:inline-block;background:var(--accent);color:#fff;font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:3px;text-transform:uppercase;padding:4px 12px;margin-bottom:14px;\" class=\"\">3-day window</div>\n          <div contenteditable=\"true\" data-ph=\"Your Results Lock In 7 Days From Today.\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:20px;color:#ffffff;text-transform:uppercase;margin-bottom:12px;line-height:1.15;\" class=\"\">Your results lock in the moment you scan</div>\n          <p contenteditable=\"true\" data-ph=\"The leaderboard drops in 7 days. No scan before it closes means your results aren't included.\" style=\"font-size:13px;color:#aaaaaa;line-height:1.8;font-weight:300;margin-bottom:20px;\" class=\"\">Your scan is your ticket to victory. Lock in those results to see just how far you've come!</p>\n          <div class=\"li-list\" data-proto=\"&lt;div class=&quot;li-wrap&quot; style=&quot;flex:1;background:rgba(0,0,0,0.2);border:1px solid #444;padding:14px 10px;text-align:center;&quot;&gt;&lt;div contenteditable=&quot;true&quot; data-ph=&quot;0&quot; style=&quot;font-family:'Montserrat',sans-serif;font-weight:900;font-size:28px;color:var(--accent);line-height:1;margin-bottom:4px;&quot;&gt;&lt;/div&gt;&lt;div contenteditable=&quot;true&quot; data-ph=&quot;Label&quot; style=&quot;font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#aaaaaa;&quot;&gt;&lt;/div&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;&lt;/div&gt;\" style=\"display:flex;gap:10px;margin-bottom:20px;\"><div class=\"li-wrap\" style=\"flex:1;background:rgba(0,0,0,0.2);border:1px solid #444;padding:14px 10px;text-align:center;\"><div contenteditable=\"true\" data-ph=\"12\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:28px;color:var(--accent);line-height:1;margin-bottom:4px;\" class=\"\">3</div><div contenteditable=\"true\" data-ph=\"Slots Open\" style=\"font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#aaaaaa;\" class=\"\">days left</div><button class=\"li-del\" onclick=\"delLi(this)\">×</button></div></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ Add counter</button>\n          <span class=\"editable-link\" data-href=\"https://app.chalkitpro.com/classschedulepublic/894\" style=\"display:block;position:relative;\"><a contenteditable=\"true\" data-ph=\"» Book My Final Scan\" style=\"display:block;background:var(--accent);color:#fff;text-decoration:none;font-family:'Montserrat',sans-serif;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:16px 28px;text-align:center;border-radius:4px;\" class=\"\" href=\"https://app.chalkitpro.com/classschedulepublic/894\">book my first scan</a><button class=\"link-edit\" type=\"button\" onclick=\"openLinkModal(this)\">🔗 link</button><button class=\"btn-del\" type=\"button\" onclick=\"removeBtn(this)\" title=\"Remove this button\">×</button></span>\n        </div>\n      </div>\n    "
