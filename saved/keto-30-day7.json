      "theme": "white",
      "html": "<div style=\"background:#faf7f5;padding:32px 48px;\">\n      <div contenteditable=\"true\" data-ph=\"The group chat\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--accent);margin-bottom:6px;\" class=\"\">weekly check-in</div>\n      <div contenteditable=\"true\" data-ph=\"Not in the WhatsApp group yet?\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:18px;color:var(--heading);line-height:1.2;\" class=\"\">How did this week go? We want to know!</div>\n      <div contenteditable=\"true\" data-ph=\"That’s where the call link, daily check-ins, and everyone’s wins live.\" style=\"font-size:13px;line-height:1.6;color:#888888;font-weight:300;margin-top:6px;\" class=\"\">Fill out this short form for a chance to appear in a future newsletter!</div>\n      <div style=\"margin-top:16px;\"><span class=\"editable-link\" data-href=\"https://link.gymntx.com/widget/form/ds4RcsvFSI93vzKHf7wr\" style=\"display:inline-block;position:relative;\"><a contenteditable=\"true\" href=\"https://link.gymntx.com/widget/form/ds4RcsvFSI93vzKHf7wr\" style=\"display:inline-block;border:2px solid var(--accent);padding:13px 30px;font-family:'Montserrat',sans-serif;font-weight:700;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--accent);text-decoration:none;\" class=\"\">Week 1 check-in form</a><button class=\"link-edit\" type=\"button\" onclick=\"openLinkModal(this)\">🔗 link</button></span></div>\n    </div>\n    "
