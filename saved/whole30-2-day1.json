      "html": "<div style=\"background:var(--secbg);position:relative;\">\n      <div style=\"height:6px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</div>\n      <div style=\"padding:38px 48px 10px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;\">\n        <div contenteditable=\"true\" data-ph=\"LNGVTY HUB\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:20px;letter-spacing:2px;color:var(--sectext);line-height:1;\" class=\"\">LNGVTY HUB</div>\n        <div contenteditable=\"true\" data-ph=\"EVIDENCE LAB\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;letter-spacing:3px;color:var(--accent);text-align:right;\" class=\"\">EVIDENCE LAB<div>CASE ACTIVE&nbsp;</div></div>\n      </div>\n      <div style=\"padding:10px 48px 6px;\">\n        <div style=\"display:inline-block;border:2px solid var(--accent);padding:5px 14px;transform:rotate(-2deg);\">\n          <div contenteditable=\"true\" data-ph=\"CONFIDENTIAL\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:13px;letter-spacing:5px;color:var(--accent);\" class=\"\">CONFIDENTIAL</div>\n        </div>\n      </div>\n      <div style=\"padding:22px 48px 12px;\">\n        <div contenteditable=\"true\" data-ph=\"CASE #W30-001\" style=\"font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:2px;color:var(--secmuted);margin-bottom:14px;\" class=\"\">CASE #0030</div>\n        <div contenteditable=\"true\" data-ph=\"THE CASE OF THE MISSING HEALTH\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:44px;line-height:.98;letter-spacing:-.5px;color:var(--sectext);text-transform:uppercase;\" class=\"\">your case is now open</div>\n      </div>\n      <div style=\"padding:14px 48px 40px;\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\n          <tbody><tr>\n            <td valign=\"top\" style=\"padding-right:28px;\">\n              <div contenteditable=\"true\" data-ph=\"SUBJECT\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--secmuted);margin-bottom:4px;\" class=\"\">SUBJECT</div>\n              <div contenteditable=\"true\" data-ph=\"You\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--accent);\" class=\"\">{{contact.first_name}}</div>\n            </td>\n            <td valign=\"top\" style=\"padding-right:28px;\">\n              <div contenteditable=\"true\" data-ph=\"DURATION\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--secmuted);margin-bottom:4px;\" class=\"\">DURATION</div>\n              <div contenteditable=\"true\" data-ph=\"30 Days\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--sectext);\" class=\"\">30 Days</div>\n            </td>\n            <td valign=\"top\">\n              <div contenteditable=\"true\" data-ph=\"STATUS\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--secmuted);margin-bottom:4px;\" class=\"\">STATS</div>\n              <div contenteditable=\"true\" data-ph=\"OPEN\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--sectext);\" class=\"\">OPEN</div>\n            </td>\n          </tr></tbody>\n        </table>\n      </div>\n      <div style=\"height:6px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</div>\n    </div>\n    \n    \n    \n    "
