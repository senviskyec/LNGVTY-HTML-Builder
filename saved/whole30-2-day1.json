style=\"flex:1;\">\n          <div contenteditable=\"true\" data-ph=\"Baseline ratings\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:14px;color:var(--heading);margin-bottom:1px;\" class=\"\">Get your baseline</div>\n          <div contenteditable=\"true\" data-ph=\"Energy, sleep, and mood — each on a scale of 1 to 5.\" style=\"font-size:12.5px;color:#8a8781;line-height:1.5;\" class=\"\">Energy, sleep, and mood. Each on a scale of 1 to 5.</div>\n        </div>\n      </div><div class=\"li-wrap\" style=\"position:relative;display:flex;gap:12px;align-items:flex-start;padding:9px 0;border-bottom:1px solid #e2ded6;\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div style=\"width:15px;height:15px;border:2px solid var(--accent);flex-shrink:0;margin-top:2px;\"></div>\n        <div style=\"flex:1;\">\n          <div contenteditable=\"true\" data-ph=\"Case notes\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:14px;color:var(--heading);margin-bottom:1px;\" class=\"\">Case notes</div>\n          <div contenteditable=\"true\" data-ph=\"One line: what made you open this case?\" style=\"font-size:12.5px;color:#8a8781;line-height:1.5;\" class=\"\">One line: What made you open this case?</div>\n        </div>\n      </div></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ item</button>\n    </div>\n    "
