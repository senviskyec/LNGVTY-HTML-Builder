button class=&quot;li-move up&quot; onclick=&quot;moveLi(this,-1)&quot; title=&quot;Move up&quot;&gt;▲&lt;/button&gt;&lt;button class=&quot;li-move dn&quot; onclick=&quot;moveLi(this,1)&quot; title=&quot;Move down&quot;&gt;▼&lt;/button&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;&lt;/td&gt;\n      &lt;/tr&gt;&lt;/table&gt;\" style=\"\"><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;margin-bottom:10px;position:relative;\"><tbody><tr>\n        <td width=\"5\" valign=\"top\" style=\"width:5px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</td>\n        <td valign=\"middle\" style=\"background:#faf7f5;padding:16px 20px;\">\n          <div contenteditable=\"true\" data-ph=\"Body Fat Percentage\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:15px;color:var(--heading);text-transform:uppercase;\" class=\"\">body fat percentage</div>\n          <div contenteditable=\"true\" data-ph=\"The share of your weight that’s fat — the number that actually moved.\" style=\"font-size:13px;line-height:1.55;color:#888888;font-weight:300;margin-top:3px;\" class=\"\">The share of your weight that's fat - the number that actually moved.</div>\n        </td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;margin-bottom:10px;position:relative;\"><tbody><tr>\n        <td width=\"5\" valign=\"top\" style=\"width:5px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</td>\n        <td valign=\"middle\" style=\"background:#faf7f5;padding:16px 20px;\">\n          <div contenteditable=\"true\" data-ph=\"Skeletal Muscle Mass\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:15px;color:var(--heading);text-transform:uppercase;\" class=\"\">skeletal muscle mass</div>\n          <div contenteditable=\"true\" data-ph=\"The muscle you kept (or built) while losing fat — that’s the goal.\" style=\"font-size:13px;line-height:1.55;color:#888888;font-weight:300;margin-top:3px;\" class=\"\">The muscle you kept (or built) while losing fat - that's the goal.</div>\n        </td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;margin-bottom:10px;position:relative;\"><tbody><tr>\n        <td width=\"5\" valign=\"top\" style=\"width:5px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</td>\n        <td valign=\"middle\" style=\"background:#faf7f5;padding:16px 20px;\">\n          <div contenteditable=\"true\" data-ph=\"Visceral Fat Level\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:15px;color:var(--heading);text-transform:uppercase;\" class=\"\">visceral fat level</div>\n          <div contenteditable=\"true\" data-ph=\"The deep belly fat around your organs — the one that matters most for health.\" style=\"font-size:13px;line-height:1.55;color:#888888;font-weight:300;margin-top:3px;\" class=\"\">The deep belly fat around your organs - the one that matters most for health.</div>\n        </td>\n        <td class=\"li-ctr