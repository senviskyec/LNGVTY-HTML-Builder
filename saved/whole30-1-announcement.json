      "key": "invCaseDetails",
      "theme": "white",
      "html": "<div style=\"background:var(--secbg);padding:36px 48px 40px;border-bottom:1px solid #e2ded6;\">\n      <div contenteditable=\"true\" data-ph=\"CASE DETAILS\" style=\"font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--accent);margin-bottom:14px;\" class=\"\">CASE DETAILS</div>\n      <div class=\"li-list\" data-proto=\"&lt;table class=&quot;li-wrap&quot; role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;position:relative;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;\n        &lt;td valign=&quot;top&quot; width=&quot;34%&quot; style=&quot;width:34%;border-bottom:1px solid #e2ded6;padding:10px 12px 10px 0;&quot;&gt;&lt;div contenteditable=&quot;true&quot; data-ph=&quot;New row&quot; style=&quot;font-family:'Montserrat',sans-serif;font-weight:800;font-size:13px;color:var(--heading);&quot;&gt;&lt;/div&gt;&lt;/td&gt;\n        &lt;td valign=&quot;top&quot; style=&quot;border-bottom:1px solid #e2ded6;padding:10px 0;&quot;&gt;&lt;div contenteditable=&quot;true&quot; data-ph=&quot;Detail goes here&quot; style=&quot;font-size:13.5px;color:#54524e;line-height:1.5;&quot;&gt;&lt;/div&gt;&lt;/td&gt;\n        &lt;td valign=&quot;middle&quot; class=&quot;li-ctrls&quot; style=&quot;width:26px;padding:0 0 0 4px;position:relative;&quot;&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;&lt;/td&gt;\n      &lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;\" style=\"\"><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td valign=\"top\" width=\"34%\" style=\"width:34%;border-bottom:1px solid #e2ded6;padding:10px 12px 10px 0;\"><div contenteditable=\"true\" data-ph=\"Starts\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:13px;color:var(--heading);\" class=\"\">Starts</div></td>\n        <td valign=\"top\" style=\"border-bottom:1px solid #e2ded6;padding:10px 0;\"><div contenteditable=\"true\" data-ph=\"Monday, [DATE] — enroll any time before Day 1\" style=\"font-size:13.5px;color:#54524e;line-height:1.5;\" class=\"\">Monday, [DATE]. Enroll at any time before Day 1</div></td>\n        <td valign=\"middle\" class=\"li-ctrls\" style=\"width:26px;padding:0 0 0 4px;position:relative;\"><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td valign=\"top\" width=\"34%\" style=\"width:34%;border-bottom:1px solid #e2ded6;padding:10px 12px 10px 0;\"><div contenteditable=\"true\" data-ph=\"Duration\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:13px;color:var(--heading);\" class=\"\">Duration</div></td>\n        <td valign=\"top\" style=\"border-bottom:1px solid #e2ded6;padding:10px 0;\"><div contenteditable=\"true\" data-ph=\"30 days · 4 weeks of investigation + reintroduction\" style=\"font-size:13.5px;color:#54524e;line-height:1.5;\" class=\"\">30 days - 4 weeks of investigation + reintroduction</div></td>\n        <td valign=\"middle\" class=\"li-ctrls\" style=\"width:26px;padding:0 0 0 4px;position:relative;\"><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td valign=\"top\" width=\"34%\" style=\"width:34%;border-bottom:1px solid #e2ded6;padding:10px 12px 10px 0;\"><div contenteditable=\"true\" data-ph=\"What you get\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:13px;color:var(--heading);\" class=\"\">What you get</div></td>\n        <td valign=\"top\" style=\"border-bottom:1px solid #e2ded6;padding:10px 0;\"><div contenteditable=\"true\" data-ph=\"Daily case briefings, a suspect board, evidence tracking, and a personalized Final Investigation Report\" style=\"font-size:13.5px;color:#54524e;line-height:1.5;\" class=\"\">Daily case breifings, a suspect board, evidence tracking, and a personalized Final Investigation Report.</div></td>\n        <td valign=\"middle\" class=\"li-ctrls\" style=\"width:26px;padding:0 0 0 4px;position:relative;\"><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td valign=\"top\" width=\"34%\" style=\"width:34%;border-bottom:1px solid #e2ded6;padding:10px 12px 10px 0;\"><div contenteditable=\"true\" data-ph=\"The rule\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:13px;color:var(--heading);\" class=\"\">The rule</div></td>\n        <td valign=\"top\" style=\"border-bottom:1px solid #e2ded6;padding:10px 0;\"><div contenteditable=\"true\" data-ph=\"Miss a day? It’s an “incomplete report,” never a failure. The case keeps building.\" style=\"font-size:13.5px;color:#54524e;line-height:1.5;\" class=\"\">Miss a day? It's an \"incomplete report,\" never a failure. The case keeps building.</div></td>\n        <td valign=\"middle\" class=\"li-ctrls\" style=\"width:26px;padding:0 0 0 4px;position:relative;\"><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td valign=\"top\" width=\"34%\" style=\"width:34%;border-bottom:1px solid #e2ded6;padding:10px 12px 10px 0;\"><div contenteditable=\"true\" data-ph=\"Cost\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:13px;color:var(--heading);\" class=\"\">Cost</div></td>\n        <td valign=\"top\" style=\"border-bottom:1px solid #e2ded6;padding:10px 0;\"><div contenteditable=\"true\" data-ph=\"Free for members · [price] for non-members\" style=\"font-size:13.5px;color:#54524e;line-height:1.5;\" class=\"\">[price] for members - [price] for non-members</div></td>\n        <td valign=\"middle\" class=\"li-ctrls\" style=\"width:26px;padding:0 0 0 4px;position:relative;\"><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ row</button>\n    </div>\n    "
