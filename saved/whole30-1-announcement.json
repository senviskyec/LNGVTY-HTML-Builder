    {
      "key": "invCaseFile",
      "theme": "dark",
      "html": "<div style=\"background:var(--secbg);position:relative;\">\n      <div style=\"height:6px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</div>\n      <div style=\"padding:38px 48px 10px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;\">\n        <div contenteditable=\"true\" data-ph=\"LNGVTY HUB\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:20px;letter-spacing:2px;color:var(--sectext);line-height:1;\" class=\"\">LNGVTY HUB</div>\n        <div contenteditable=\"true\" data-ph=\"EVIDENCE LAB\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;letter-spacing:3px;color:var(--accent);text-align:right;\" class=\"\">EVIDENCE LAB</div>\n      </div>\n      <div style=\"padding:10px 48px 6px;\">\n        <div style=\"display:inline-block;border:2px solid var(--accent);padding:5px 14px;transform:rotate(-2deg);\">\n          <div contenteditable=\"true\" data-ph=\"CONFIDENTIAL\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:13px;letter-spacing:5px;color:var(--accent);\" class=\"\">CONFIDENTIAL</div>\n        </div>\n      </div>\n      <div style=\"padding:22px 48px 12px;\">\n        <div contenteditable=\"true\" data-ph=\"CASE #W30-001\" style=\"font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:2px;color:var(--secmuted);margin-bottom:14px;\" class=\"\">CASE #0030</div>\n        <div contenteditable=\"true\" data-ph=\"THE CASE OF THE MISSING HEALTH\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:44px;line-height:.98;letter-spacing:-.5px;color:var(--sectext);text-transform:uppercase;\" class=\"\">The case of the missing health</div>\n      </div>\n      <div style=\"padding:14px 48px 40px;\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\n          <tbody><tr>\n            <td valign=\"top\" style=\"padding-right:28px;\">\n              <div contenteditable=\"true\" data-ph=\"SUBJECT\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--secmuted);margin-bottom:4px;\" class=\"\">SUBJECT</div>\n              <div contenteditable=\"true\" data-ph=\"You\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--accent);\" class=\"\">{{contact.first_name}}</div>\n            </td>\n            <td valign=\"top\" style=\"padding-right:28px;\">\n              <div contenteditable=\"true\" data-ph=\"DURATION\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--secmuted);margin-bottom:4px;\" class=\"\">DURATION</div>\n              <div contenteditable=\"true\" data-ph=\"30 Days\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--sectext);\" class=\"\">30 Days</div>\n            </td>\n            <td valign=\"top\">\n              <div contenteditable=\"true\" data-ph=\"STATUS\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--secmuted);margin-bottom:4px;\" class=\"\">STATS</div>\n              <div contenteditable=\"true\" data-ph=\"OPEN\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--sectext);\" class=\"\">OPEN</div>\n            </td>\n          </tr></tbody>\n        </table>\n      </div>\n      <div style=\"height:6px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</div>\n    </div>\n    \n    \n    "
    },
    {
      "key": "invBriefingWeeks",
      "theme": "cream",
      "html": "<div style=\"background:var(--secbg);padding:40px 48px 44px;border:1px solid rgba(0,0,0,.10);\">\n      <div contenteditable=\"true\" data-ph=\"INVESTIGATOR BRIEFING\" style=\"font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;letter-spacing:4px;color:var(--accent);margin-bottom:8px;\" class=\"\">INVESTIGATOR BREIFING</div>\n      <div contenteditable=\"true\" data-ph=\"A new case opens this month.\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:24px;line-height:1.15;color:var(--sectext);text-transform:uppercase;margin-bottom:8px;\" class=\"\">A new case file opens this month.</div>\n      <div contenteditable=\"true\" data-ph=\"Over the next four weeks you’ll build the case yourself: cut the usual suspects, gather the evidence, and finally find out what’s been working against you.\" style=\"font-size:14px;line-height:1.65;color:var(--secmuted);max-width:52ch;margin-bottom:20px;\" class=\"\"><p style=\"font-size: 14.5px; line-height: 1.7; color: rgb(84, 82, 78); max-width: 52ch; font-family: &quot;Open Sans&quot;, Arial, sans-serif;\">Something has been stealing your energy, focus, sleep, and performance — and there are multiple suspects but no evidence. Over the next four weeks you'll build the case yourself: cut the usual suspects, gather the evidence, and finally find out what's been working against you.</p></div>\n      <div class=\"li-list\" data-proto=\"&lt;div class=&quot;li-wrap&quot; style=&quot;position:relative;display:flex;gap:14px;align-items:flex-start;padding:11px 0;border-bottom:1px dashed rgba(0,0,0,.14);&quot;&gt;\n        &lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;\n        &lt;div contenteditable=&quot;true&quot; data-ph=&quot;WEEK 5&quot; style=&quot;font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;letter-spacing:1.5px;color:var(--accent);white-space:nowrap;min-width:58px;padding-top:2px;&quot;&gt;&lt;/div&gt;\n        &lt;div style=&quot;flex:1;&quot;&gt;\n          &lt;div contenteditable=&quot;true&quot; data-ph=&quot;New phase&quot; style=&quot;font-family:'Montserrat',sans-serif;font-weight:800;font-size:15px;color:var(--sectext);margin-bottom:2px;&quot;&gt;&lt;/div&gt;\n          &lt;div contenteditable=&quot;true&quot; data-ph=&quot;What happens in this stretch.&quot; style=&quot;font-size:13px;color:var(--secmuted);line-height:1.5;&quot;&gt;&lt;/div&gt;\n        &lt;/div&gt;\n      &lt;/div&gt;\" style=\"\"><div class=\"li-wrap\" style=\"position:relative;display:flex;gap:14px;align-items:flex-start;padding:11px 0;border-bottom:1px dashed rgba(0,0,0,.14);\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div contenteditable=\"true\" data-ph=\"WEEK 1\" style=\"font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;letter-spacing:1.5px;color:var(--accent);white-space:nowrap;min-width:58px;padding-top:2px;\" class=\"\">WEEK 1</div>\n        <div style=\"flex:1;\">\n          <div contenteditable=\"true\" data-ph=\"Arrive at the Crime Scene\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:15px;color:var(--sectext);margin-bottom:2px;\" class=\"\">Arrive at the Crime Scene</div>\n          <div contenteditable=\"true\" data-ph=\"Gather baseline evidence. Observe — don’t accuse anyone yet.\" style=\"font-size:13px;color:var(--secmuted);line-height:1.5;\" class=\"\">Gather baseline evidence. Observe - don't accuse anyone yet.<div><br></div></div>\n        </div>\n      </div><div class=\"li-wrap\" style=\"position:relative;display:flex;gap:14px;align-items:flex-start;padding:11px 0;border-bottom:1px dashed rgba(0,0,0,.14);\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div contenteditable=\"true\" data-ph=\"WEEK 2\" style=\"font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;letter-spacing:1.5px;color:var(--accent);white-space:nowrap;min-width:58px;padding-top:2px;\" class=\"\">WEEK 2</div>\n        <div style=\"flex:1;\">\n          <div contenteditable=\"true\" data-ph=\"Interview the Suspects\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:15px;color:var(--sectext);margin-bottom:2px;\" class=\"\">Interview the Suspects</div>\n          <div contenteditable=\"true\" data-ph=\"One food group in the spotlight each day. Investigating, not convicting.\" style=\"font-size:13px;color:var(--secmuted);line-height:1.5;\" class=\"\">One food group in the spotlight each day. Investigating not convincing.<div><br></div></div>\n        </div>\n      </div><div class=\"li-wrap\" style=\"position:relative;display:flex;gap:14px;align-items:flex-start;padding:11px 0;border-bottom:1px dashed rgba(0,0,0,.14);\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div contenteditable=\"true\" data-ph=\"WEEK 3\" style=\"font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;letter-spacing:1.5px;color:var(--accent);white-space:nowrap;min-width:58px;padding-top:2px;\" class=\"\">WEEK 3</div>\n        <div style=\"flex:1;\">\n          <div contenteditable=\"true\" data-ph=\"Build the Case\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:15px;color:var(--sectext);margin-bottom:2px;\" class=\"\">Build the Case</div>\n          <div contenteditable=\"true\" data-ph=\"Watch the trends connect. Your own evidence starts telling the story.\" style=\"font-size:13px;color:var(--secmuted);line-height:1.5;\" class=\"\">Watch the trends connect. Your own evidence starts telling the story.<div><br></div></div>\n        </div>\n      </div><div class=\"li-wrap\" style=\"position:relative;display:flex;gap:14px;align-items:flex-start;padding:11px 0;border-bottom:1px dashed rgba(0,0,0,.14);\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div contenteditable=\"true\" data-ph=\"WEEK 4\" style=\"font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;letter-spacing:1.5px;color:var(--accent);white-space:nowrap;min-width:58px;padding-top:2px;\" class=\"\">WEEK 4</div>\n        <div style=\"flex:1;\">\n          <div contenteditable=\"true\" data-ph=\"Close the Case\" style=\"font-family:'Montserrat',sans-serif;font-weight:800;font-size:15px;color:var(--sectext);margin-bottom:2px;\" class=\"\">Close the Case</div>\n          <div contenteditable=\"true\" data-ph=\"Name the culprit, plan reintroduction, and get your final report.\" style=\"font-size:13px;color:var(--secmuted);line-height:1.5;\" class=\"\">Name the culprit, plan reintroduction, and get your final report.<div><br></div></div>\n        </div>\n      </div></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ week</button>\n      <div style=\"margin-top:22px;padding-top:18px;border-top:2px solid var(--accent);\">\n        <div contenteditable=\"true\" data-ph=\"THE GOAL\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:3px;color:var(--accent);margin-bottom:6px;\" class=\"\">THE GOAL</div>\n        <div contenteditable=\"true\" data-ph=\"By Day 30 you’ll have a complete case file — and finally know which foods have been holding you back.\" style=\"font-family:'Montserrat',sans-serif;font-weight:700;font-size:16px;line-height:1.5;color:var(--sectext);max-width:48ch;\" class=\"\">By Day 30 you'll have a complete case file and finally know which foods have been holding you back.</div>\n      </div>\n    </div>\n    "
    },
