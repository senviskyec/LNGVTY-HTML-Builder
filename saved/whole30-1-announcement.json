    {
      "key": "invCaseFile",
      "theme": "dark",
      "html": "<div style=\"background:var(--secbg);position:relative;\">\n      <div style=\"height:6px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</div>\n      <div style=\"padding:38px 48px 10px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;\">\n        <div contenteditable=\"true\" data-ph=\"LNGVTY HUB\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:20px;letter-spacing:2px;color:var(--sectext);line-height:1;\" class=\"\">LNGVTY HUB</div>\n        <div contenteditable=\"true\" data-ph=\"EVIDENCE LAB\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;letter-spacing:3px;color:var(--accent);text-align:right;\" class=\"\">EVIDENCE LAB</div>\n      </div>\n      <div style=\"padding:10px 48px 6px;\">\n        <div style=\"display:inline-block;border:2px solid var(--accent);padding:5px 14px;transform:rotate(-2deg);\">\n          <div contenteditable=\"true\" data-ph=\"CONFIDENTIAL\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:13px;letter-spacing:5px;color:var(--accent);\" class=\"\">CONFIDENTIAL</div>\n        </div>\n      </div>\n      <div style=\"padding:22px 48px 12px;\">\n        <div contenteditable=\"true\" data-ph=\"CASE #W30-001\" style=\"font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:2px;color:var(--secmuted);margin-bottom:14px;\" class=\"\">CASE #0030</div>\n        <div contenteditable=\"true\" data-ph=\"THE CASE OF THE MISSING HEALTH\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:44px;line-height:.98;letter-spacing:-.5px;color:var(--sectext);text-transform:uppercase;\" class=\"\">The case of the missing health</div>\n      </div>\n      <div style=\"padding:14px 48px 40px;\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\n          <tbody><tr>\n            <td valign=\"top\" style=\"padding-right:28px;\">\n              <div contenteditable=\"true\" data-ph=\"SUBJECT\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--secmuted);margin-bottom:4px;\" class=\"\">SUBJECT</div>\n              <div contenteditable=\"true\" data-ph=\"You\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--accent);\" class=\"\">{{contact.first_name}}</div>\n            </td>\n            <td valign=\"top\" style=\"padding-right:28px;\">\n              <div contenteditable=\"true\" data-ph=\"DURATION\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--secmuted);margin-bottom:4px;\" class=\"\">DURATION</div>\n              <div contenteditable=\"true\" data-ph=\"30 Days\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--sectext);\" class=\"\">30 Days</div>\n            </td>\n            <td valign=\"top\">\n              <div contenteditable=\"true\" data-ph=\"STATUS\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:2px;color:var(--secmuted);margin-bottom:4px;\" class=\"\">STATS</div>\n              <div contenteditable=\"true\" data-ph=\"OPEN\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--sectext);\" class=\"\">OPEN</div>\n            </td>\n          </tr></tbody>\n        </table>\n      </div>\n      <div style=\"height:6px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</div>\n    </div>\n    \n    "
    },
    {
      "key": "invStakeout",
      "theme": "white",
      "html": "<div style=\"background:var(--secbg);padding:38px 48px 42px;border-left:5px solid var(--accent);\">\n      <div contenteditable=\"true\" data-ph=\"FROM THE CHIEF INVESTIGATOR\" style=\"font-family:'JetBrains Mono',monospace;font-size:9.5px;font-weight:700;letter-spacing:3.5px;color:var(--accent);margin-bottom:10px;\" class=\"\">INVESTIGATOR BRIEFING</div>\n      <div contenteditable=\"true\" data-ph=\"Stakeout Notes\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:28px;text-transform:uppercase;color:var(--sectext);margin-bottom:14px;\" class=\"\">A new case opens this month.</div>\n      <div class=\"li-list\" data-proto=\"&lt;div class=&quot;li-wrap&quot; style=&quot;position:relative;margin-bottom:12px;&quot;&gt;&lt;div contenteditable=&quot;true&quot; data-ph=&quot;New paragraph&quot; style=&quot;font-size:15px;line-height:1.8;color:var(--sectext);&quot;&gt;&lt;/div&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;&lt;/div&gt;\" style=\"\"><div class=\"li-wrap\" style=\"position:relative;margin-bottom:12px;\"><div contenteditable=\"true\" data-ph=\"Here’s what I want you watching for this week. Most people miss it because they’re looking at the scale instead of the evidence.\" style=\"font-size:15px;line-height:1.8;color:var(--sectext);\" class=\"\"><span style=\"color: rgb(84, 82, 78); font-family: &quot;Open Sans&quot;, Arial, sans-serif; font-size: 14.5px;\">Something has been stealing your energy, focus, sleep, and performance — and there are multiple suspects but no evidence. Over the next four weeks you'll build the case yourself: cut the usual suspects, gather the evidence, and finally find out what's been working against you.</span></div><button class=\"li-del\" onclick=\"delLi(this)\">×</button></div></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ paragraph</button>\n      <div style=\"margin-top:18px;padding-top:14px;border-top:1px dashed rgba(0,0,0,.2);\">\n        <div contenteditable=\"true\" data-ph=\"— Tim, Chief Investigator\" style=\"font-family:'Montserrat',sans-serif;font-weight:700;font-size:13px;letter-spacing:.5px;color:var(--accent);\" class=\"\">By day 30 you'll have a complete case file - and finally know which foods have been holding you back.</div>\n      </div>\n    </div>\n    "
    },
    {
      "key": "invTimeline",
      "theme": "dark",
      "html": "<div style=\"background:var(--secbg);padding:40px 48px 44px;\">\n      <div contenteditable=\"true\" data-ph=\"CASE TIMELINE\" style=\"font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;letter-spacing:4px;color:var(--accent);margin-bottom:16px;\" class=\"\">CASE TIMELINE</div>\n      <div class=\"li-list\" data-proto=\"&lt;div class=&quot;li-wrap&quot; style=&quot;position:relative;padding:0 0 22px 46px;&quot;&gt;\n        &lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;\n        &lt;div style=&quot;position:absolute;left:0;top:2px;width:30px;height:30px;border:2px solid var(--accent);border-radius:50%;text-align:center;line-height:27px;&quot;&gt;\n          &lt;span contenteditable=&quot;true&quot; data-ph=&quot;D0&quot; style=&quot;font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:var(--accent);display:inline;&quot;&gt;&lt;/span&gt;\n        &lt;/div&gt;\n        &lt;div contenteditable=&quot;true&quot; data-ph=&quot;New stage&quot; style=&quot;font-family:'Montserrat',sans-serif;font-weight:900;font-size:16px;color:var(--sectext);text-transform:uppercase;margin-bottom:3px;&quot;&gt;&lt;/div&gt;\n        &lt;div contenteditable=&quot;true&quot; data-ph=&quot;What happens here.&quot; style=&quot;font-size:13px;line-height:1.55;color:var(--secmuted);max-width:52ch;&quot;&gt;&lt;/div&gt;\n      &lt;/div&gt;\" style=\"\"><div class=\"li-wrap\" style=\"position:relative;padding:0 0 22px 46px;\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div style=\"position:absolute;left:0;top:2px;width:30px;height:30px;border:2px solid var(--accent);border-radius:50%;text-align:center;line-height:27px;\">\n          <span contenteditable=\"true\" data-ph=\"D1\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:var(--accent);display:inline;\" class=\"\">W1</span>\n        </div>\n        <div contenteditable=\"true\" data-ph=\"Case Opened\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:16px;color:var(--sectext);text-transform:uppercase;margin-bottom:3px;\" class=\"\">Arrive at the Crime Scene</div>\n        <div contenteditable=\"true\" data-ph=\"Pantry cleared, baseline symptoms logged, suspects identified.\" style=\"font-size:13px;line-height:1.55;color:var(--secmuted);max-width:52ch;\" class=\"\">Gather baseline evidence. Observe - don't accuse anyone yet.</div>\n      </div><div class=\"li-wrap\" style=\"position:relative;padding:0 0 22px 46px;\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div style=\"position:absolute;left:0;top:2px;width:30px;height:30px;border:2px solid var(--accent);border-radius:50%;text-align:center;line-height:27px;\">\n          <span contenteditable=\"true\" data-ph=\"D5\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:var(--accent);display:inline;\" class=\"\">W2</span>\n        </div>\n        <div contenteditable=\"true\" data-ph=\"First Withdrawal\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:16px;color:var(--sectext);text-transform:uppercase;margin-bottom:3px;\" class=\"\">Interview the suspects</div>\n        <div contenteditable=\"true\" data-ph=\"The hardest stretch. Expect resistance from the suspects.\" style=\"font-size:13px;line-height:1.55;color:var(--secmuted);max-width:52ch;\" class=\"\">One food group is the spotlight each day. Investigating, not convicting.</div>\n      </div><div class=\"li-wrap\" style=\"position:relative;padding:0 0 22px 46px;\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div style=\"position:absolute;left:0;top:2px;width:30px;height:30px;border:2px solid var(--accent);border-radius:50%;text-align:center;line-height:27px;\">\n          <span contenteditable=\"true\" data-ph=\"D10\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:var(--accent);display:inline;\" class=\"\">W3</span>\n        </div>\n        <div contenteditable=\"true\" data-ph=\"Early Evidence\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:16px;color:var(--sectext);text-transform:uppercase;margin-bottom:3px;\" class=\"\">Build the case</div>\n        <div contenteditable=\"true\" data-ph=\"Energy and sleep begin to shift. Log everything.\" style=\"font-size:13px;line-height:1.55;color:var(--secmuted);max-width:52ch;\" class=\"\">atch the trends connect. Your own evidence starts telling the story.</div>\n      </div><div class=\"li-wrap\" style=\"position:relative;padding:0 0 22px 46px;\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div style=\"position:absolute;left:0;top:2px;width:30px;height:30px;border:2px solid var(--accent);border-radius:50%;text-align:center;line-height:27px;\">\n          <span contenteditable=\"true\" data-ph=\"D20\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:var(--accent);display:inline;\" class=\"\">W4</span>\n        </div>\n        <div contenteditable=\"true\" data-ph=\"Pattern Emerges\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:16px;color:var(--sectext);text-transform:uppercase;margin-bottom:3px;\" class=\"\">Close the case</div>\n        <div contenteditable=\"true\" data-ph=\"The field narrows. Some suspects start looking innocent.\" style=\"font-size:13px;line-height:1.55;color:var(--secmuted);max-width:52ch;\" class=\"\">Name the culprit, plan reintroduction, and get your final report.</div>\n      </div></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ stage</button>\n    </div>\n    "
    },
    {
      "key": "chMetrics",
      "theme": "white",
      "html": "<div style=\"background:var(--secbg);padding:44px 48px;\">\n        <div contenteditable=\"true\" data-ph=\"Your final results\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--accent);margin-bottom:18px;\" class=\"\">Case details</div>\n        <p contenteditable=\"true\" data-ph=\"Your FitManager scan report is attached. Compare these numbers to your Day 0 scan.\" style=\"font-size:15px;line-height:1.75;color:var(--secmuted);font-weight:300;margin-bottom:20px;\" class=\"is-empty\"></p>\n        <div class=\"li-list\" data-proto=\"&lt;table class=&quot;li-wrap&quot; role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;margin-bottom:10px;position:relative;&quot;&gt;&lt;tr&gt;\n        &lt;td width=&quot;5&quot; valign=&quot;top&quot; style=&quot;width:5px;background:var(--accent);font-size:0;line-height:0;&quot;&gt;&amp;nbsp;&lt;/td&gt;\n        &lt;td valign=&quot;middle&quot; style=&quot;background:#faf7f5;padding:16px 20px;&quot;&gt;\n          &lt;div contenteditable=&quot;true&quot; data-ph=&quot;New Metric&quot; style=&quot;font-family:'Montserrat',sans-serif;font-weight:900;font-size:15px;color:var(--heading);text-transform:uppercase;&quot;&gt;&lt;/div&gt;\n          &lt;div contenteditable=&quot;true&quot; data-ph=&quot;What this number means.&quot; style=&quot;font-size:13px;line-height:1.55;color:#888888;font-weight:300;margin-top:3px;&quot;&gt;&lt;/div&gt;\n        &lt;/td&gt;\n        &lt;td class=&quot;li-ctrls&quot; valign=&quot;top&quot; style=&quot;width:0;font-size:0;line-height:0;white-space:nowrap;&quot;&gt;&lt;button class=&quot;li-move up&quot; onclick=&quot;moveLi(this,-1)&quot; title=&quot;Move up&quot;&gt;▲&lt;/button&gt;&lt;button class=&quot;li-move dn&quot; onclick=&quot;moveLi(this,1)&quot; title=&quot;Move down&quot;&gt;▼&lt;/button&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;&lt;/td&gt;\n      &lt;/tr&gt;&lt;/table&gt;\" style=\"\"><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;margin-bottom:10px;position:relative;\"><tbody><tr>\n        <td width=\"5\" valign=\"top\" style=\"width:5px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</td>\n        <td valign=\"middle\" style=\"background:#faf7f5;padding:16px 20px;\">\n          <div contenteditable=\"true\" data-ph=\"Body Fat Percentage\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:15px;color:var(--heading);text-transform:uppercase;\" class=\"\">Starts Monday, [DATE]</div>\n          <div contenteditable=\"true\" data-ph=\"The share of your weight that’s fat — the number that actually moved.\" style=\"font-size:13px;line-height:1.55;color:#888888;font-weight:300;margin-top:3px;\" class=\"\">Enroll anytime before day 1.</div>\n        </td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;margin-bottom:10px;position:relative;\"><tbody><tr>\n        <td width=\"5\" valign=\"top\" style=\"width:5px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</td>\n        <td valign=\"middle\" style=\"background:#faf7f5;padding:16px 20px;\">\n          <div contenteditable=\"true\" data-ph=\"Skeletal Muscle Mass\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:15px;color:var(--heading);text-transform:uppercase;\" class=\"\">Lasts 30 days</div>\n          <div contenteditable=\"true\" data-ph=\"The muscle you kept (or built) while losing fat — that’s the goal.\" style=\"font-size:13px;line-height:1.55;color:#888888;font-weight:300;margin-top:3px;\" class=\"\">4 weeks of investigation + reintroduction.</div>\n        </td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;margin-bottom:10px;position:relative;\"><tbody><tr>\n        <td width=\"5\" valign=\"top\" style=\"width:5px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</td>\n        <td valign=\"middle\" style=\"background:#faf7f5;padding:16px 20px;\">\n          <div contenteditable=\"true\" data-ph=\"Visceral Fat Level\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:15px;color:var(--heading);text-transform:uppercase;\" class=\"\">What you get?</div>\n          <div contenteditable=\"true\" data-ph=\"The deep belly fat around your organs — the one that matters most for health.\" style=\"font-size:13px;line-height:1.55;color:#888888;font-weight:300;margin-top:3px;\" class=\"\">Daily case briefings, a suspect board, evidence tracking, and a personalized Final Investigation Report.</div>\n        </td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;margin-bottom:10px;position:relative;\"><tbody><tr>\n        <td width=\"5\" valign=\"top\" style=\"width:5px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</td>\n        <td valign=\"middle\" style=\"background:#faf7f5;padding:16px 20px;\">\n          <div contenteditable=\"true\" data-ph=\"New Metric\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:15px;color:var(--heading);text-transform:uppercase;\" class=\"\">The Rule</div>\n          <div contenteditable=\"true\" data-ph=\"What this number means.\" style=\"font-size:13px;line-height:1.55;color:#888888;font-weight:300;margin-top:3px;\" class=\"\">Miss a day? It's an \"incomplete report,\" never a failure. The case keeps building.</div>\n        </td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;margin-bottom:10px;position:relative;\"><tbody><tr>\n        <td width=\"5\" valign=\"top\" style=\"width:5px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</td>\n        <td valign=\"middle\" style=\"background:#faf7f5;padding:16px 20px;\">\n          <div contenteditable=\"true\" data-ph=\"New Metric\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:15px;color:var(--heading);text-transform:uppercase;\" class=\"\">Cost</div>\n          <div contenteditable=\"true\" data-ph=\"What this number means.\" style=\"font-size:13px;line-height:1.55;color:#888888;font-weight:300;margin-top:3px;\" class=\"\">[Price] for members. [Price ]for non-members.</div>\n        </td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ Add metric</button>\n      </div>\n    "
    },
    {
      "key": "nlcta",
      "theme": "gray",
      "html": "<div style=\"background:var(--secbg);padding:44px 48px;text-align:center;border-bottom:1px solid #eee;\">\n      <div contenteditable=\"true\" data-ph=\"Ready for This Week?\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:26px;color:#fff;text-transform:uppercase;margin-bottom:8px;\" class=\"\">Ready to open the case?</div>\n      <div contenteditable=\"true\" data-ph=\"Show up. Stay consistent. The results take care of themselves.\" style=\"font-size:13px;color:#aaa;margin-bottom:28px;font-weight:300;\" class=\"\">Enlist at the front desk or tap below to reserve your file.</div>\n      <span class=\"editable-link\" data-href=\"https://app.chalkitpro.com/classschedulepublic/894\" style=\"display:inline-block;position:relative;\"><a contenteditable=\"true\" data-ph=\"» Book Your Session\" style=\"display:inline-block;background:var(--accent);color:#fff;font-family:'Montserrat',sans-serif;font-weight:700;font-size:14px;letter-spacing:2px;text-transform:uppercase;text-decoration:none;padding:18px 44px;border-radius:4px;\" class=\"\">Enlist</a><button class=\"link-edit\" type=\"button\" onclick=\"openLinkModal(this)\">🔗 link</button><button class=\"btn-del\" type=\"button\" onclick=\"removeBtn(this)\" title=\"Remove this button\">×</button></span>\n      <div style=\"margin-top:16px;\"><div contenteditable=\"true\" data-ph=\"Questions? Reply to this email — a real person will respond.\" style=\"font-size:12px;color:#888;font-weight:300;\" class=\"is-empty\"></div></div>\n    </div>\n    "
    },
    {
