      "html": "<div style=\"padding:28px 48px;text-align:center;background:var(--secbg);\">\n      <div contenteditable=\"true\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:16px;letter-spacing:2px;color:var(--secmuted);margin-bottom:10px;\">LNGVTY HUB · CARRBORO</div>\n      <div style=\"text-align:center;margin:12px 0;\">\n        <span class=\"editable-link\" data-href=\"https://www.facebook.com/LNGVTYHubNC\" style=\"display:inline-block;position:relative;\"><a contenteditable=\"true\" href=\"https://www.facebook.com/LNGVTYHubNC\" style=\"font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--secmuted);text-decoration:none;border:1px solid #ddd;padding:5px 12px;display:inline-block;margin:0 4px;\"><span style=\"color: rgb(224, 90, 27);\">Facebook</span></a><button class=\"link-edit\" type=\"button\" onclick=\"openLinkModal(this)\">🔗 link</button></span><span class=\"editable-link\" data-href=\"https://www.instagram.com/lngvtyhub/\" style=\"display:inline-block;position:relative;\"><a contenteditable=\"true\" href=\"https://www.instagram.com/lngvtyhub/\" style=\"font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--secmuted);text-decoration:none;border:1px solid #ddd;padding:5px 12px;display:inline-block;margin:0 4px;\"><span style=\"color: rgb(224, 90, 27);\">Instagram</span></a><button class=\"link-edit\" type=\"button\" onclick=\"openLinkModal(this)\">🔗 link</button></span><span class=\"editable-link\" data-href=\"https://lngvtyhub.com/\" style=\"display:inline-block;position:relative;\"><a contenteditable=\"true\" href=\"https://lngvtyhub.com/\" style=\"font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--secmuted);text-decoration:none;border:1px solid #ddd;padding:5px 12px;display:inline-block;margin:0 4px;\"><span style=\"color: rgb(