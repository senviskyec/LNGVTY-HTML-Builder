      "key": "chCall",
      "theme": "white",
      "html": "<div style=\"background:var(--secbg);padding:44px 48px 20px;\">\n      <div contenteditable=\"true\" data-ph=\"This is happening today\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:#bbbbbb;margin-bottom:6px;\" class=\"\">this is happening today</div>\n      <div contenteditable=\"true\" data-ph=\"Weekly Check-In Call\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--sectext);text-transform:uppercase;line-height:1.1;margin-bottom:20px;\" class=\"\">weekly check-in call #2</div>\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;border:1px solid #f0f0f0;margin-bottom:20px;\"><tbody><tr>\n        <td width=\"80\" valign=\"middle\" align=\"center\" style=\"width:80px;background:var(--gray);padding:16px 8px;text-align:center;\">\n          <div contenteditable=\"true\" data-ph=\"Week 1\" style=\"font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#ffffff;opacity:.7;\" class=\"\">Week 2</div>\n          <div contenteditable=\"true\" data-ph=\"07\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:30px;color:#ffffff;line-height:1.1;\" class=\"\">14</div>\n          <div contenteditable=\"true\" data-ph=\"Sunday\" style=\"font-size:9px;color:#ffffff;opacity:.6;font-weight:300;text-transform:capitalize;margin-top:2px;\" class=\"\">Sunday</div>\n        </td>\n        <td valign=\"top\" style=\"padding:16px 18px;\">\n          <div style=\"margin-bottom:6px;\"><span contenteditable=\"true\" data-ph=\"Sunday at [TIME]\" style=\"font-family:'Montserrat',sans-serif;font-weight:700;font-size:15px;color:var(--heading);text-transform:uppercase;display:inline;\" class=\"\">Sunay at [time]</span> <span contenteditable=\"true\" data-ph=\"· LNGVTY Hub\" style=\"font-size:12px;color:#999999;font-weight:300;display:inline;\" class=\"\">LNGVTY Hub</span></div>\n          <div contenteditable=\"true\" data-ph=\"One line about the call — bring your questions.\" style=\"font-size:13px;line-height:1.65;color:#888888;font-weight:300;\" class=\"\">This is where things get interesting. Bring your questions.</div>\n          <div style=\"margin-top:10px;\"><span contenteditable=\"true\" data-ph=\"In person + Zoom\" style=\"font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:4px 9px;background:rgba(224,90,27,.12);color:var(--accent);display:inline-block;\" class=\"\">Zoom</span></div>\n        </td>\n      </tr></tbody></table>\n      <div contenteditable=\"true\" data-ph=\"On the agenda\" style=\"font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#bbbbbb;margin-bottom:12px;\" class=\"\">on the agena</div>\n      <div class=\"li-list\" data-proto=\"&lt;table class=&quot;li-wrap&quot; role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;position:relative;&quot;&gt;&lt;tr&gt;&lt;td width=&quot;16&quot; valign=&quot;top&quot; style=&quot;width:16px;font-size:14px;color:var(--accent);line-height:1.7;&quot;&gt;›&lt;/td&gt;&lt;td valign=&quot;top&quot; style=&quot;padding-bottom:4px;&quot;&gt;&lt;div contenteditable=&quot;true&quot; data-ph=&quot;New agenda item&quot; style=&quot;font-size:14px;line-height:1.7;color:var(--secmuted);font-weight:300;&quot;&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;li-ctrls&quot; valign=&quot;top&quot; style=&quot;width:0;font-size:0;line-height:0;white-space:nowrap;&quot;&gt;&lt;button class=&quot;li-move up&quot; onclick=&quot;moveLi(this,-1)&quot; title=&quot;Move up&quot;&gt;▲&lt;/button&gt;&lt;button class=&quot;li-move dn&quot; onclick=&quot;moveLi(this,1)&quot; title=&quot;Move down&quot;&gt;▼&lt;/button&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;\" style=\"\"><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr><td width=\"16\" valign=\"top\" style=\"width:16px;font-size:14px;color:var(--accent);line-height:1.7;\">›</td><td valign=\"top\" style=\"padding-bottom:4px;\"><div contenteditable=\"true\" data-ph=\"First agenda item.\" style=\"font-size:14px;line-height:1.7;color:var(--secmuted);font-weight:300;\" class=\"\">Intermittent fasting Q&amp;A (follow-up from the Day 8 + Day 11 videos)</div></td><td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td></tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr><td width=\"16\" valign=\"top\" style=\"width:16px;font-size:14px;color:var(--accent);line-height:1.7;\">›</td><td valign=\"top\" style=\"padding-bottom:4px;\"><div contenteditable=\"true\" data-ph=\"Second agenda item.\" style=\"font-size:14px;line-height:1.7;color:var(--secmuted);font-weight:300;\" class=\"\">Troubleshoot cravings or a plateau</div></td><td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td></tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr><td width=\"16\" valign=\"top\" style=\"width:16px;font-size:14px;color:var(--accent);line-height:1.7;\">›</td><td valign=\"top\" style=\"padding-bottom:4px;\"><div contenteditable=\"true\" data-ph=\"Third agenda item.\" style=\"font-size:14px;line-height:1.7;color:var(--secmuted);font-weight:300;\" class=\"\">Spotlight a member success story</div></td><td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td></tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr><td width=\"16\" valign=\"top\" style=\"width:16px;font-size:14px;color:var(--accent);line-height:1.7;\">›</td><td valign=\"top\" style=\"padding-bottom:4px;\"><div contenteditable=\"true\" data-ph=\"New agenda item\" style=\"font-size:14px;line-height:1.7;color:var(--secmuted);font-weight:300;\" class=\"\">Preview Week 3 - the halfway wall, self-sabotage, sleep + cortisol</div></td><td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td></tr></tbody></table></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ Add agenda item</button>\n      <div style=\"margin-top:24px;\"><span class=\"editable-link\" data-href=\"#\" style=\"display:inline-block;position:relative;\"><a contenteditable=\"true\"