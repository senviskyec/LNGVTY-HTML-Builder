    {
      "key": "chBody",
      "theme": "white",
      "html": "<div style=\"background:var(--secbg);padding:44px 48px;\">\n        <div contenteditable=\"true\" data-ph=\"The good news\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--accent);margin-bottom:18px;\" class=\"\">the good news</div>\n        <div class=\"li-list\" data-proto=\"&lt;table class=&quot;li-wrap&quot; role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;position:relative;&quot;&gt;&lt;tr&gt;\n        &lt;td valign=&quot;top&quot;&gt;&lt;p contenteditable=&quot;true&quot; data-ph=&quot;New paragraph&quot; style=&quot;font-size:15px;line-height:1.75;color:var(--secmuted);font-weight:300;margin-bottom:18px;&quot;&gt;&lt;/p&gt;&lt;/td&gt;\n        &lt;td class=&quot;li-ctrls&quot; valign=&quot;top&quot; style=&quot;width:0;font-size:0;line-height:0;white-space:nowrap;&quot;&gt;&lt;button class=&quot;li-move up&quot; onclick=&quot;moveLi(this,-1)&quot; title=&quot;Move up&quot;&gt;▲&lt;/button&gt;&lt;button class=&quot;li-move dn&quot; onclick=&quot;moveLi(this,1)&quot; title=&quot;Move down&quot;&gt;▼&lt;/button&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;&lt;/td&gt;\n      &lt;/tr&gt;&lt;/table&gt;\" style=\"\"><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td valign=\"top\"><p contenteditable=\"true\" data-ph=\"Your paragraph goes here. Write as much as you like — this block is for the letter or intro copy.\" style=\"font-size:15px;line-height:1.75;color:var(--secmuted);font-weight:300;margin-bottom:18px;\" class=\"\">Two weeks in. You've earned some good news: you don't have to give up sweets. You just have to <span style=\"font-weight: bold;\">upgrade</span> them</p></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ Add paragraph</button>\n        <div style=\"margin-top:14px;\"><span contenteditable=\"true\" data-ph=\"— Tim\" style=\"font-family:'Montserrat',sans-serif;font-weight:700;font-size:14px;color:var(--sectext);\" class=\"\">- Tim</span></div>\n      </div>\n    "
    },
    {
      "key": "chList",
      "theme": "white",
      "html": "<div style=\"background:var(--secbg);padding:40px 48px;\">\n        <div contenteditable=\"true\" data-ph=\"List heading\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--accent);margin-bottom:20px;\" class=\"\">keto-friendly sweet options</div>\n        <div class=\"li-list\" data-proto=\"&lt;table class=&quot;li-wrap&quot; role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;position:relative;&quot;&gt;&lt;tr&gt;\n        &lt;td width=&quot;20&quot; valign=&quot;top&quot; style=&quot;width:20px;font-size:16px;color:var(--accent);line-height:1.6;font-weight:700;&quot;&gt;›&lt;/td&gt;\n        &lt;td valign=&quot;top&quot; style=&quot;padding:0 0 14px 4px;&quot;&gt;&lt;div contenteditable=&quot;true&quot; data-ph=&quot;New list item&quot; style=&quot;font-size:14px;line-height:1.65;color:var(--secmuted);font-weight:300;&quot;&gt;&lt;/div&gt;&lt;/td&gt;\n        &lt;td class=&quot;li-ctrls&quot; valign=&quot;top&quot; style=&quot;width:0;font-size:0;line-height:0;white-space:nowrap;&quot;&gt;&lt;button class=&quot;li-move up&quot; onclick=&quot;moveLi(this,-1)&quot; title=&quot;Move up&quot;&gt;▲&lt;/button&gt;&lt;button class=&quot;li-move dn&quot; onclick=&quot;moveLi(this,1)&quot; title=&quot;Move down&quot;&gt;▼&lt;/button&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;&lt;/td&gt;\n      &lt;/tr&gt;&lt;/table&gt;\" style=\"\"><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td width=\"20\" valign=\"top\" style=\"width:20px;font-size:16px;color:var(--accent);line-height:1.6;font-weight:700;\">›</td>\n        <td valign=\"top\" style=\"padding:0 0 14px 4px;\"><div contenteditable=\"true\" data-ph=\"First list item — click to edit.\" style=\"font-size:14px;line-height:1.65;color:var(--secmuted);font-weight:300;\" class=\"\"><span style=\"font-weight: bold;\">keto ice cream -</span>&nbsp;Aldi's peanut butter fudge is a personal favorite (read the labels on Halo and Enlightened too).</div></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td width=\"20\" valign=\"top\" style=\"width:20px;font-size:16px;color:var(--accent);line-height:1.6;font-weight:700;\">›</td>\n        <td valign=\"top\" style=\"padding:0 0 14px 4px;\"><div contenteditable=\"true\" data-ph=\"Second item with a longer description that wraps to show how it flows.\" style=\"font-size:14px;line-height:1.65;color:var(--secmuted);font-weight:300;\" class=\"\"><span style=\"font-weight: bold;\">Two Good Yogurt </span>with chopped nuts.</div></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td width=\"20\" valign=\"top\" style=\"width:20px;font-size:16px;color:var(--accent);line-height:1.6;font-weight:700;\">›</td>\n        <td valign=\"top\" style=\"padding:0 0 14px 4px;\"><div contenteditable=\"true\" data-ph=\"Third item.\" style=\"font-size:14px;line-height:1.65;color:var(--secmuted);font-weight:300;\" class=\"\">A scoop of <span style=\"font-weight: bold;\">natural peanut butter </span>(just peanuts + salt) with a sprinkle of monk fruit and Lily's stevia chocolate chips.</div></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td width=\"20\" valign=\"top\" style=\"width:20px;font-size:16px;color:var(--accent);line-height:1.6;font-weight:700;\">›</td>\n        <td valign=\"top\" style=\"padding:0 0 14px 4px;\"><div contenteditable=\"true\" data-ph=\"New list item\" style=\"font-size:14px;line-height:1.65;color:var(--secmuted);font-weight:300;\" class=\"\"><span style=\"font-weight: bold;\">Keto mug cakes</span>&nbsp;- Google or Pinterest have thousands of recipes. Top with homemade whipped cream and a pinch of monk fruit</div></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td width=\"20\" valign=\"top\" style=\"width:20px;font-size:16px;color:var(--accent);line-height:1.6;font-weight:700;\">›</td>\n        <td valign=\"top\" style=\"padding:0 0 14px 4px;\"><div contenteditable=\"true\" data-ph=\"New list item\" style=\"font-size:14px;line-height:1.65;color:var(--secmuted);font-weight:300;\" class=\"\"><span style=\"font-weight: bold;\">Peanut Butter Cookies - </span>recipe attached. Always double the batch.</div></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ Add item</button>\n      </div>\n    "
