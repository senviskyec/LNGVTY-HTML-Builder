      "key": "chHeader",
      "theme": "dark",
      "html": "<div style=\"background:var(--secbg);\">\n      <div style=\"padding:44px 48px 0;\">\n        <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:16px;\">\n          <div contenteditable=\"true\" data-ph=\"LNGVTY HUB\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;letter-spacing:2px;color:var(--sectext);line-height:1;\" class=\"\">LNGVTY <span style=\"color: rgb(224, 90, 27);\">HUB</span></div>\n          <div contenteditable=\"true\" data-ph=\"Keto 30-Day Challenge\" style=\"font-family:'Montserrat',sans-serif;font-size:9px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--accent);text-align:right;\" class=\"is-empty\"></div>\n        </div>\n      </div>\n      <div style=\"padding:34px 48px 44px;\">\n        <div contenteditable=\"true\" data-ph=\"Day 7 · Sunday\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:#888888;margin-bottom:14px;\" class=\"\">Day 14 | Sunday | halfway there</div>\n        <div contenteditable=\"true\" data-ph=\"One Week Down.\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:56px;line-height:0.92;letter-spacing:1px;text-transform:uppercase;color:var(--sectext);\" class=\"\">you can still have sweets.</div>\n        <div contenteditable=\"true\" data-ph=\"Your subheadline goes here.\" style=\"font-family:'Montserrat',sans-serif;font-weight:300;font-size:15px;color:var(--secmuted);margin-top:18px;letter-spacing:.5px;\" class=\"\">Just the right kind. Tim's go-to keto sweets list, plus your second check-in call.</div>\n      </div>\n      <div style=\"height:5px;background:var(--accent);font-size:0;line-height:0;\">&nbsp;</div>\n    </div>\n    "
    },
    {
      "key": "chStrip",
      "theme": "orange",
      "html": "<div style=\"background:var(--secbg);padding:15px 48px;text-align:center;\">\n      <div contenteditable=\"true\" data-ph=\"★  Two weeks down — you’re at the halfway mark  ★\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--sectext);\" class=\"\">★ Two weeks down - You're at the halfway mark ★</div>\n    </div>\n    "
