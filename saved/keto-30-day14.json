    {
      "key": "chChips",
      "theme": "white",
      "html": "<div style=\"background:#faf7f5;padding:34px 48px;\">\n        <div contenteditable=\"true\" data-ph=\"Sweeteners that won’t spike your insulin\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--accent);margin-bottom:6px;\" class=\"\">sweeteners that won't spike your insulin</div>\n        <div contenteditable=\"true\" data-ph=\"Short supporting line under the heading.\" style=\"font-size:13px;line-height:1.6;color:#888888;font-weight:300;margin-bottom:18px;\" class=\"\">Try a couple and find your favorite - your taste buds will adjust over time.</div>\n        <div style=\"margin-bottom:6px;\"><div class=\"li-list\" data-proto=\"&lt;span class=&quot;li-wrap&quot; style=&quot;display:inline-block;position:relative;margin:0 8px 8px 0;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#ffffff;border:1px solid #ead9d0;padding:9px 14px;&quot;&gt;&lt;span contenteditable=&quot;true&quot; data-ph=&quot;New chip&quot; style=&quot;font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--heading);display:inline;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot; style=&quot;top:-6px;right:-6px;&quot;&gt;×&lt;/button&gt;&lt;/span&gt;\" style=\"\"><span class=\"li-wrap\" style=\"display:inline-block;position:relative;margin:0 8px 8px 0;\"><span style=\"display:inline-block;background:#ffffff;border:1px solid #ead9d0;padding:9px 14px;\"><span contenteditable=\"true\" data-ph=\"Stevia\" style=\"font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--heading);display:inline;\" class=\"\">Stevia</span></span><button class=\"li-del\" onclick=\"delLi(this)\" style=\"top:-6px;right:-6px;\">×</button></span><span class=\"li-wrap\" style=\"display:inline-block;position:relative;margin:0 8px 8px 0;\"><span style=\"display:inline-block;background:#ffffff;border:1px solid #ead9d0;padding:9px 14px;\"><span contenteditable=\"true\" data-ph=\"Monk Fruit\" style=\"font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--heading);display:inline;\" class=\"\">monk fruit</span></span><button class=\"li-del\" onclick=\"delLi(this)\" style=\"top:-6px;right:-6px;\">×</button></span><span class=\"li-wrap\" style=\"display:inline-block;position:relative;margin:0 8px 8px 0;\"><span style=\"display:inline-block;background:#ffffff;border:1px solid #ead9d0;padding:9px 14px;\"><span contenteditable=\"true\" data-ph=\"Erythritol\" style=\"font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--heading);display:inline;\" class=\"\">erythritol</span></span><button class=\"li-del\" onclick=\"delLi(this)\" style=\"top:-6px;right:-6px;\">×</button></span><span class=\"li-wrap\" style=\"display:inline-block;position:relative;margin:0 8px 8px 0;\"><span style=\"display:inline-block;background:#ffffff;border:1px solid #ead9d0;padding:9px 14px;\"><span contenteditable=\"true\" data-ph=\"Allulose\" style=\"font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--heading);display:inline;\" class=\"\">Allulose</span></span><button class=\"li-del\" onclick=\"delLi(this)\" style=\"top:-6px;right:-6px;\">×</button></span><span class=\"li-wrap\" style=\"display:inline-block;position:relative;margin:0 8px 8px 0;\"><span style=\"display:inline-block;background:#ffffff;border:1px solid #ead9d0;padding:9px 14px;\"><span contenteditable=\"true\" data-ph=\"Swerve\" style=\"font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--heading);display:inline;\" class=\"\">swerve</span></span><button class=\"li-del\" onclick=\"delLi(this)\" style=\"top:-6px;right:-6px;\">×</button></span></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ Add chip</button></div>\n        <div style=\"margin-top:14px;\"><div class=\"li-list\" data-proto=\"&lt;table class=&quot;li-wrap&quot; role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;position:relative;&quot;&gt;&lt;tr&gt;\n        &lt;td width=&quot;16&quot; valign=&quot;top&quot; style=&quot;width:16px;font-size:13px;color:var(--accent);line-height:1.6;&quot;&gt;›&lt;/td&gt;\n        &lt;td valign=&quot;top&quot; style=&quot;padding:0 0 2px 4px;&quot;&gt;&lt;div contenteditable=&quot;true&quot; data-ph=&quot;New note&quot; style=&quot;font-size:13px;line-height:1.6;color:#777777;font-weight:300;&quot;&gt;&lt;/div&gt;&lt;/td&gt;\n        &lt;td class=&quot;li-ctrls&quot; valign=&quot;top&quot; style=&quot;width:0;font-size:0;line-height:0;white-space:nowrap;&quot;&gt;&lt;button class=&quot;li-move up&quot; onclick=&quot;moveLi(this,-1)&quot; title=&quot;Move up&quot;&gt;▲&lt;/button&gt;&lt;button class=&quot;li-move dn&quot; onclick=&quot;moveLi(this,1)&quot; title=&quot;Move down&quot;&gt;▼&lt;/button&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;&lt;/td&gt;\n      &lt;/tr&gt;&lt;/table&gt;\" style=\"\"><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td width=\"16\" valign=\"top\" style=\"width:16px;font-size:13px;color:var(--accent);line-height:1.6;\">›</td>\n        <td valign=\"top\" style=\"padding:0 0 2px 4px;\"><div contenteditable=\"true\" data-ph=\"First note about the options above.\" style=\"font-size:13px;line-height:1.6;color:#777777;font-weight:300;\" class=\"\">Liquid <span style=\"font-weight: bold;\">stevia</span>&nbsp;is great in coffee.</div></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td width=\"16\" valign=\"top\" style=\"width:16px;font-size:13px;color:var(--accent);line-height:1.6;\">›</td>\n        <td valign=\"top\" style=\"padding:0 0 2px 4px;\"><div contenteditable=\"true\" data-ph=\"Second note.\" style=\"font-size:13px;line-height:1.6;color:#777777;font-weight:300;\" class=\"\"><span style=\"font-weight: bold;\">Monk fruit</span>&nbsp;is Tim's choice for baking.</div></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ Add note</button></div>\n      </div>\n    "
    },
    {
      "key": "introbox",
      "theme": "white",
      "html": "<div style=\"background:var(--secbg);padding:36px 48px;border-bottom:1px solid #eee;\">\n        <div contenteditable=\"true\" data-ph=\"Pre-Start\" style=\"font-family:'Montserrat',sans-serif;font-size:10px;letter-spacing:4px;text-transform:uppercase;color:#bbb;margin-bottom:6px;\" class=\"\">read now</div>\n        <div contenteditable=\"true\" data-ph=\"Before Day 1 Hits, Read This.\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:22px;color:var(--heading);text-transform:uppercase;margin-bottom:4px;line-height:1.1;\" class=\"\">Word of caution</div>\n        <div style=\"background:#fafafa;border-left:3px solid var(--accent);padding:20px 24px;margin-top:14px;\">\n          <div class=\"li-list\" data-proto=\"&lt;table class=&quot;li-wrap&quot; role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;width:100%;border-collapse:collapse;position:relative;&quot;&gt;&lt;tr&gt;\n        &lt;td valign=&quot;top&quot;&gt;&lt;p contenteditable=&quot;true&quot; data-ph=&quot;New paragraph&quot; style=&quot;font-size:14px;color:var(--body-text);line-height:1.85;font-weight:300;margin-bottom:10px;&quot;&gt;&lt;/p&gt;&lt;/td&gt;\n        &lt;td class=&quot;li-ctrls&quot; valign=&quot;top&quot; style=&quot;width:0;font-size:0;line-height:0;white-space:nowrap;&quot;&gt;&lt;button class=&quot;li-move up&quot; onclick=&quot;moveLi(this,-1)&quot; title=&quot;Move up&quot;&gt;▲&lt;/button&gt;&lt;button class=&quot;li-move dn&quot; onclick=&quot;moveLi(this,1)&quot; title=&quot;Move down&quot;&gt;▼&lt;/button&gt;&lt;button class=&quot;li-del&quot; onclick=&quot;delLi(this)&quot;&gt;×&lt;/button&gt;&lt;/td&gt;\n      &lt;/tr&gt;&lt;/table&gt;\" style=\"\"><table class=\"li-wrap\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;position:relative;\"><tbody><tr>\n        <td valign=\"top\"><p contenteditable=\"true\" data-ph=\"Hey {{contact.first_name}} — the challenge kicks off soon and we want you prepared, not winging it. This covers the four things that make or break week one.\" style=\"font-size:14px;color:var(--body-text);line-height:1.85;font-weight:300;margin-bottom:10px;\" class=\"\">Not every internet recipe that calls itself \"keto\" actually is. <span style=\"font-weight: bold;\">Check the macros. Read the reviews.</span>&nbsp;And when you find a great one - share it in the WhatsApp group. That knowledge lifts all of us.</p></td>\n        <td class=\"li-ctrls\" valign=\"top\" style=\"width:0;font-size:0;line-height:0;white-space:nowrap;\"><button class=\"li-move up\" onclick=\"moveLi(this,-1)\" title=\"Move up\">▲</button><button class=\"li-move dn\" onclick=\"moveLi(this,1)\" title=\"Move down\">▼</button><button class=\"li-del\" onclick=\"delLi(this)\">×</button></td>\n      </tr></tbody></table></div>\n    <button class=\"li-add\" onclick=\"addLi(this)\">+ Add paragraph</button>\n        </div>\n      </div>\n    "
    },
    {
      "key": "chAttach",
      "theme": "dark",
