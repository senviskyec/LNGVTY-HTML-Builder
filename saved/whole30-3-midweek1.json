    {
      "key": "topbar",
      "theme": "orange",
      "html": "<div style=\"background:var(--accent);padding:10px 24px;text-align:center;\">\n      <span contenteditable=\"true\" data-ph=\"LNGVTY Hub — Your Check-In\" style=\"font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#fff;\" class=\"\">LNGVTY HUB • EVIDENCE LAB</span>\n    </div>\n    \n    ",
