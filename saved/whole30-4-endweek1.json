rue\" data-ph=\"Case Opened\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:16px;color:var(--sectext);text-transform:uppercase;margin-bottom:3px;\" class=\"\">CASE OPENED</div>\n        <div contenteditable=\"true\" data-ph=\"Pantry cleared, baseline symptoms logged, suspects identified.\" style=\"font-size:13px;line-height:1.55;color:var(--secmuted);max-width:52ch;\" class=\"\">Baseline stats and symptoms recorded.</div>\n      </div><div class=\"li-wrap\" style=\"position:relative;padding:0 0 22px 46px;\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div style=\"position:absolute;left:0;top:2px;width:30px;height:30px;border:2px solid var(--accent);border-radius:50%;text-align:center;line-height:27px;\">\n          <span contenteditable=\"true\" data-ph=\"D5\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:var(--accent);display:inline;\" class=\"\">D3</span>\n        </div>\n        <div contenteditable=\"true\" data-ph=\"First Withdrawal\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:16px;color:var(--sectext);text-transform:uppercase;margin-bottom:3px;\" class=\"\">First clues</div>\n        <div contenteditable=\"true\" data-ph=\"The hardest stretch. Expect resistance from the suspects.\" style=\"font-size:13px;line-height:1.55;color:var(--secmuted);max-width:52ch;\" class=\"\">Craving patterns logged - the first behavioral evidence.</div>\n      </div><div class=\"li-wrap\" style=\"position:relative;padding:0 0 22px 46px;\">\n        <button class=\"li-del\" onclick=\"delLi(this)\">×</button>\n        <div style=\"position:absolute;left:0;top:2px;width:30px;height:30px;border:2px solid var(--accent);border-radius:50%;text-align:center;line-height:27px;\">\n          <span contenteditable=\"true\" data-ph=\"D10\" style=\"font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:var(--accent);display:inline;\" class=\"\">D5</span>