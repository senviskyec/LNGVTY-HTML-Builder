      "key": "cta",
      "theme": "gray",
      "html": "<div style=\"background:var(--secbg);padding:44px 48px;text-align:center;\">\n      <div contenteditable=\"true\" data-ph=\"Book Your Scan\" style=\"font-family:'Montserrat',sans-serif;font-weight:900;font-size:28px;color:var(--sectext);text-transform:uppercase;margin-bottom:8px;line-height:1.1;\" class=\"\">tell us how it went</div>\n      <p contenteditable=\"true\" data-ph=\"Takes 60 seconds. Shows you everything. Book it now before the window passes.\" style=\"font-size:13px;color:var(--secmuted);margin-bottom:28px;font-weight:300;line-height:1.7;\" class=\"\">Your story helps the next person start theirs.</p>\n      <span class=\"editable-link\" data-href=\"https://link.gymntx.com/widget/form/nFpOhfJ5yMbMC134YCNR\" style=\"display:inline-block;position:relative;\"><a contenteditable=\"true\" data-ph=\"» Schedule My Scan\" style=\"display:inline-block;background:var(--accent);color:#fff;font-family:'Montserrat',sans-serif;font-weight:700;font-size:14px;letter-spacing:2px;text-transform:uppercase;text-decoration:none;padding:18px 44px;border-radius:4px;margin-bottom:16px;\" class=\"\" href=\"https://link.gymntx.com/widget/form/nFpOhfJ5yMbMC134YCNR\">share your experience &gt;</a><button class=\"link-edit\" type=\"button\" onclick=\"openLinkModal(this)\">🔗 link</button><button class=\"btn-del\" type=\"button\" onclick=\"removeBtn(this)\" title=\"Remove this button\">×</button></span>\n      <p contenteditable=\"true\" data-ph=\"Questions? Reply to this email — a real person will respond.\" style=\"font-size:12px;color:var(--secmuted);font-weight:300;\" class=\"is-empty\"></p>\n    </div>\n    "
